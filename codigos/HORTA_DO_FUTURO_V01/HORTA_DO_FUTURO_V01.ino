#include "sistema.h"

#include "display.h"

#include "menu.h"


//=====================================================
// CONTROLE DE TEMPO
//=====================================================

unsigned long ultimoCiclo = 0;


//=====================================================
// SETUP
//=====================================================

void setup()
{
    Serial.begin(115200);

    delay(500);


    Serial.println();

    Serial.println("================================");
    Serial.println("        HORTA DO FUTURO");
    Serial.println("      COMPUTADOR DE PLANTAS");
    Serial.println("          Firmware V1.0");
    Serial.println("================================");


    //=============================================
    // SISTEMA
    //=============================================

    iniciarSistema();


    //=============================================
    // OLED
    //=============================================

    iniciarDisplay();


    //=============================================
    // TELA INICIAL
    //=============================================

    mostrarInicializacao();


    delay(1500);


    //=============================================
    // MONITORAMENTO
    //=============================================

    estadoAtual = MONITORAMENTO;
}


//=====================================================
// LOOP
//=====================================================

void loop()
{
    unsigned long agora = millis();


    //=============================================
    // CICLO DE MONITORAMENTO
    //=============================================

    if(
        agora - ultimoCiclo >=
        INTERVALO_CICLO
    )
    {
        ultimoCiclo = agora;

        executarCiclo();
    }


    //=============================================
    // INTERFACE
    //=============================================

    atualizarInterface();


    //=============================================
    // MENU
    //=============================================

    atualizarMenu();
}